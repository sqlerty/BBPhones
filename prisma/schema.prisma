generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
enum PhoneCondition {
  NEW          
  USED   
}
model Users {
  id         String     @id @default(uuid()) @db.Uuid
  email      String     @unique
  password   String     
  name       String?
  avatarUrl  String?    @map("avatar_url")
  role       UserRole   @default(USER)
  createdAt  DateTime   @default(now()) @map("created_at")
  orders     Orders[]
  favorites  Favorites[]
  reviews    Reviews[]
  cart       Cart[]     

  @@map("users")
}

model Brands {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  
  phones  Phones[]

  @@map("brands")
}

model Phones {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      String[] @default([])
  ram         Int
  storage     Int
  color       String
  specs       Json? 
  condition       PhoneCondition @default(NEW)
  defectDetails   String?   
  createdAt   DateTime @default(now()) @map("created_at")
  brandId  String   @db.Uuid @map("brand_id")
  brand    Brands @relation(fields: [brandId], references: [id], onDelete: Restrict)
  averageRating Float    @default(0)
  reviewCount   Int      @default(0)
  orderItems  OrderItems[]
  favorites   Favorites[]
  reviews     Reviews[]
  cart        Cart[]

  @@map("phones")
}

model Orders {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid @map("user_id")
  user        Users        @relation(fields: [userId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2) @map("total_amount")
  address     String
  phone       String
  createdAt   DateTime    @default(now()) @map("created_at")
  orderItems  OrderItems[]

  @@map("orders")
}

model OrderItems {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid @map("order_id")
  order     Orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phoneId String  @db.Uuid @map("phone_id")
  phone Phones @relation(fields: [phoneId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  @@map("order_items")
}

model Favorites {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneId String   @db.Uuid @map("phone_id")
  phone   Phones  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, phoneId])
  @@map("favorites")
}

model Reviews {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  user      Users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneId String   @db.Uuid @map("phone_id")
  phone   Phones  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  rating    Int      
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Cart {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid @map("user_id")
  user      Users   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneId String   @db.Uuid @map("phone_id")
  phone   Phones  @relation(fields: [phoneId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([userId, phoneId])
  @@map("cart")
}